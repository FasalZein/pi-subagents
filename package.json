{
	"name": "pi-subagents",
	"version": "2.9.2",
	"description": "Power-user multi-agent framework for Pi: named agents, interactive sessions via Herdr/cmux/tmux/zellij/WezTerm, background workers, async/sync coordination, fork/resume, child-to-parent messaging, orchestrator mode, and a live TUI",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"author": "edxeth",
	"repository": {
		"type": "git",
		"url": "https://github.com/edxeth/pi-subagents"
	},
	"type": "module",
	"scripts": {
		"test": "node --test test/test.ts test/system-prompt-mode.test.ts test/runtime/widget.test.ts test/mux/cmux.test.ts test/live-test-guard.test.ts scripts/context-cost-probe.test.mjs",
		"test:e2e-live-blocking": "node scripts/test-e2e-live-blocking.mjs",
		"test:e2e-live-mix-blocking": "node scripts/test-e2e-live-mix-blocking.mjs",
		"test:e2e-live-deny-tools": "node scripts/test-e2e-live-deny-tools.mjs",
		"test:e2e-live-tools": "node scripts/test-e2e-live-tools.mjs",
		"test:e2e-live-extensions": "node scripts/test-e2e-live-extensions.mjs",
		"test:e2e-live-skill-visibility": "node scripts/test-e2e-live-skill-visibility.mjs",
		"test:e2e-live-skill-visibility-codex": "node scripts/test-e2e-live-skill-visibility-codex.mjs",
		"test:e2e-live-stop-after-turn": "node scripts/test-e2e-live-stop-after-turn.mjs",
		"test:e2e-live-mixed-batch": "node scripts/test-e2e-live-mixed-batch.mjs",
		"test:e2e-live-verified-fanout": "node scripts/test-e2e-live-verified-fanout.mjs",
		"test:frontmatter-timeout": "node scripts/test-frontmatter-timeout.mjs",
		"test:frontmatter-idle-timeout": "node scripts/test-frontmatter-idle-timeout.mjs",
		"test:frontmatter-timeout-warn": "node scripts/test-frontmatter-timeout-warn.mjs",
		"test:frontmatter-on-timeout": "node scripts/test-frontmatter-on-timeout.mjs",
		"test:live-herdr-mux": "node scripts/test-live-herdr-mux.mjs",
		"test:live-herdr-pi": "node scripts/test-live-herdr-pi.mjs",
		"test:live-herdr-timeout-wrap-up": "node scripts/test-live-herdr-timeout-wrap-up.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.5.2",
		"@earendil-works/pi-coding-agent": ">=1.5.2",
		"@earendil-works/pi-tui": ">=1.5.2",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.5.2",
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@earendil-works/pi-tui": "^1.5.2",
		"@types/node": "^25.9.1",
		"typebox": "1.3.27",
		"typescript": "^6.0.3"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"scripts/context-cost-probe.mjs",
			"scripts/orchestration-benchmark.mjs",
			"scripts/orchestration-benchmark-gate.mjs",
			"scripts/orchestration-benchmark/freeze-agents.mjs",
			"scripts/orchestration-benchmark/load-probe.ts",
			"scripts/orchestration-benchmark/scenarios/**/*.mjs",
			"scripts/pi-extension-load.mjs",
			"scripts/roster-limits-benchmark.mjs"
		],
		"ignoreFiles": [
			"scripts/live-vf-candidate-router.mjs",
			"scripts/check-file-sizes.mjs",
			"src/launch/run-child.mjs"
		],
		"ignoreIssues": {
			"scripts/orchestration-benchmark/{attempt,baseline-plan,baseline-report,delivery,record,sample-home}.mjs": [
				"exports"
			]
		}
	},
	"trustedDependencies": [
		"koffi",
		"protobufjs"
	]
}
